{"id": "spec-01", "text": "彼女は一人暮らしを始めてしまった。", "source": {"corpus": "spec-examples", "ref": "spec-01", "license": "CC-BY-SA-4.0", "attribution": "monosashi SPEC.md worked example: compound with an accepted split; chain through てしまう"}, "register": "conversation", "slice": "synthetic", "units": [{"start": 0, "end": 2, "surface": "彼女", "kind": "word", "entries": [1483150], "form": "彼女", "reading": "かのじょ", "form_reading": "かのじょ"}, {"start": 2, "end": 3, "surface": "は", "kind": "particle"}, {"start": 3, "end": 8, "surface": "一人暮らし", "kind": "word", "entries": [1613340], "form": "一人暮らし", "reading": "ひとりぐらし", "form_reading": "ひとりぐらし", "split_points": [5], "targets": ["compound", "counter-reading"]}, {"start": 8, "end": 9, "surface": "を", "kind": "particle"}, {"start": 9, "end": 16, "surface": "始めてしまった", "kind": "word", "entries": [1307550], "form": "始める", "reading": "はじめてしまった", "form_reading": "はじめる", "chain": ["-て", "-しまう", "-た"], "targets": ["inflection-chain", "te-auxiliary"]}], "label": {"status": "adjudicated", "spec": "0.5"}}
