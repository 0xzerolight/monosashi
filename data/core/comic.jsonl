{"id": "syn-kansai-035", "text": "ほんまかいな！宝くじ当たったん？", "source": {"corpus": "synthetic", "ref": "kansai-035", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "comic", "slice": "synthetic", "units": [{"start": 0, "end": 3, "surface": "ほんま", "kind": "word", "entries": [2001000], "form": "ほんま", "reading": "ほんま", "form_reading": "ほんま", "targets": ["kansai", "colloquial-variant"], "normalized": {"form": "本当", "form_reading": "ほんとう", "entries": [1523060]}}, {"start": 3, "end": 5, "surface": "かい", "kind": "particle"}, {"start": 5, "end": 6, "surface": "な", "kind": "particle"}, {"start": 7, "end": 10, "surface": "宝くじ", "kind": "word", "entries": [1516170], "form": "宝くじ", "reading": "たからくじ", "form_reading": "たからくじ", "split_points": [8], "targets": ["compound"]}, {"start": 10, "end": 14, "surface": "当たった", "kind": "word", "entries": [1448810], "form": "当たる", "reading": "あたった", "form_reading": "あたる", "chain": ["-た"]}, {"start": 14, "end": 15, "surface": "ん", "kind": "particle"}], "label": {"status": "agreed", "spec": "0.5"}}
