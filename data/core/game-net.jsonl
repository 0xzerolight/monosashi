{"id": "syn-oov-017", "text": "味方がわざとトロってて試合にならない。", "source": {"corpus": "synthetic", "ref": "oov-017", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "game-net", "slice": "synthetic", "units": [{"start": 0, "end": 2, "surface": "味方", "kind": "word", "entries": [1527070], "form": "味方", "reading": "みかた", "form_reading": "みかた"}, {"start": 2, "end": 3, "surface": "が", "kind": "particle"}, {"start": 3, "end": 6, "surface": "わざと", "kind": "word", "entries": [1410760], "form": "わざと", "reading": "わざと", "form_reading": "わざと"}, {"start": 6, "end": 11, "surface": "トロってて", "kind": "word", "form": "トロる", "reading": "とろってて", "form_reading": "とろる", "chain": ["-て", "-いる", "-て"], "targets": ["oov", "inflection-chain", "te-auxiliary", "contraction", "katakana"]}, {"start": 11, "end": 13, "surface": "試合", "kind": "word", "entries": [1312420], "form": "試合", "reading": "しあい", "form_reading": "しあい"}, {"start": 13, "end": 14, "surface": "に", "kind": "particle"}, {"start": 14, "end": 18, "surface": "ならない", "kind": "word", "entries": [1375610], "form": "なる", "reading": "ならない", "form_reading": "なる", "chain": ["negative"]}], "label": {"status": "adjudicated", "spec": "0.5"}}
{"id": "syn-oov-018", "text": "ボス戦をノーダメで抜けたらスクショ貼るね。", "source": {"corpus": "synthetic", "ref": "oov-018", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "game-net", "slice": "synthetic", "units": [{"start": 0, "end": 3, "surface": "ボス戦", "kind": "word", "entries": [2848081], "form": "ボス戦", "reading": "ぼすせん", "form_reading": "ぼすせん", "split_points": [2], "targets": ["compound"]}, {"start": 3, "end": 4, "surface": "を", "kind": "particle"}, {"start": 4, "end": 8, "surface": "ノーダメ", "kind": "word", "form": "ノーダメ", "reading": "のーだめ", "form_reading": "のーだめ", "split_points": [6], "targets": ["oov", "katakana"]}, {"start": 8, "end": 9, "surface": "で", "kind": "particle"}, {"start": 9, "end": 13, "surface": "抜けたら", "kind": "word", "entries": [1478200], "form": "抜ける", "reading": "ぬけたら", "form_reading": "ぬける", "chain": ["-たら"]}, {"start": 13, "end": 17, "surface": "スクショ", "kind": "word", "entries": [2065080], "form": "スクショ", "reading": "すくしょ", "form_reading": "すくしょ", "targets": ["katakana"]}, {"start": 17, "end": 19, "surface": "貼る", "kind": "word", "entries": [1427900], "form": "貼る", "reading": "はる", "form_reading": "はる"}, {"start": 19, "end": 20, "surface": "ね", "kind": "particle"}], "label": {"status": "audited", "spec": "0.5"}}
{"id": "syn-oov-019", "text": "ランク沼にハマって三日間同じ帯から抜け出せない。", "source": {"corpus": "synthetic", "ref": "oov-019", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "game-net", "slice": "synthetic", "units": [{"start": 0, "end": 4, "surface": "ランク沼", "kind": "word", "form": "ランク沼", "reading": "らんくぬま", "form_reading": "らんくぬま", "split_points": [3], "targets": ["oov", "katakana"]}, {"start": 4, "end": 5, "surface": "に", "kind": "particle"}, {"start": 5, "end": 9, "surface": "ハマって", "kind": "word", "entries": [1601030], "form": "ハマる", "reading": "はまって", "form_reading": "はまる", "chain": ["-て"], "targets": ["katakana-form"]}, {"start": 9, "end": 11, "surface": "三日", "kind": "word", "entries": [1301330], "form": "三日", "reading": "みっか", "form_reading": "みっか", "split_points": [10], "targets": ["counter", "counter-reading", "suffix"]}, {"start": 11, "end": 12, "surface": "間", "kind": "suffix"}, {"start": 12, "end": 14, "surface": "同じ", "kind": "word", "entries": [1451750], "form": "同じ", "reading": "おなじ", "form_reading": "おなじ"}, {"start": 14, "end": 15, "surface": "帯", "kind": "word", "entries": [1410410], "form": "帯", "reading": "おび", "form_reading": "おび", "targets": ["heteronym"]}, {"start": 15, "end": 17, "surface": "から", "kind": "particle"}, {"start": 17, "end": 23, "surface": "抜け出せない", "kind": "word", "entries": [1478220], "form": "抜け出す", "reading": "ぬけだせない", "form_reading": "ぬけだす", "chain": ["potential", "negative"], "targets": ["inflection-chain", "potential-ranuki"]}], "label": {"status": "adjudicated", "spec": "0.5"}}
{"id": "syn-oov-020", "text": "このステージ、初見殺しの罠が多すぎるだろ。", "source": {"corpus": "synthetic", "ref": "oov-020", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "game-net", "slice": "synthetic", "units": [{"start": 0, "end": 2, "surface": "この", "kind": "word", "entries": [1582920], "form": "この", "reading": "この", "form_reading": "この"}, {"start": 2, "end": 6, "surface": "ステージ", "kind": "word", "entries": [1070320], "form": "ステージ", "reading": "すてーじ", "form_reading": "すてーじ", "targets": ["katakana"]}, {"start": 7, "end": 9, "surface": "初見", "kind": "word", "entries": [1798820], "form": "初見", "reading": "しょけん", "form_reading": "しょけん", "targets": ["suffix"]}, {"start": 9, "end": 11, "surface": "殺し", "kind": "suffix"}, {"start": 11, "end": 12, "surface": "の", "kind": "particle"}, {"start": 12, "end": 13, "surface": "罠", "kind": "word", "entries": [1570620], "form": "罠", "reading": "わな", "form_reading": "わな"}, {"start": 13, "end": 14, "surface": "が", "kind": "particle"}, {"start": 14, "end": 18, "surface": "多すぎる", "kind": "word", "entries": [1407460], "form": "多い", "reading": "おおすぎる", "form_reading": "おおい", "chain": ["-すぎる"]}, {"start": 18, "end": 20, "surface": "だろ", "kind": "expression", "entries": [1928670], "form": "だろ", "reading": "だろ", "form_reading": "だろ", "targets": ["contraction"]}], "label": {"status": "adjudicated", "spec": "0.5"}}
