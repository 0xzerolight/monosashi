{"id": "syn-oov-024", "text": "ゆる勢なので週末しかログインしません。", "source": {"corpus": "synthetic", "ref": "oov-024", "license": "CC-BY-SA-4.0", "attribution": "monosashi synthetic sentence, written by Claude (Anthropic), 2026-10-15"}, "register": "game-net", "slice": "synthetic", "units": [{"start": 0, "end": 2, "surface": "ゆる", "kind": "word", "form": "ゆる", "reading": "ゆる", "form_reading": "ゆる", "targets": ["oov", "suffix"]}, {"start": 2, "end": 3, "surface": "勢", "kind": "suffix"}, {"start": 3, "end": 4, "surface": "な", "kind": "copula"}, {"start": 4, "end": 6, "surface": "ので", "kind": "particle"}, {"start": 6, "end": 8, "surface": "週末", "kind": "word", "entries": [1333520], "form": "週末", "reading": "しゅうまつ", "form_reading": "しゅうまつ"}, {"start": 8, "end": 10, "surface": "しか", "kind": "particle"}, {"start": 10, "end": 18, "surface": "ログインしません", "kind": "word", "entries": [1147120], "form": "ログイン", "reading": "ろぐいんしません", "form_reading": "ろぐいん", "chain": ["-ます", "negative"], "targets": ["suru-verb", "inflection-chain", "katakana"]}], "label": {"status": "audited", "spec": "0.5"}}
